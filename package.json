{
  "name": "clean-writer",
  "version": "2.0.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:ui": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html src-tauri/*.json src-tauri/capabilities/*.json .github/workflows/*.yml",
    "format:check": "prettier --check src tests *.ts *.json index.html src-tauri/*.json src-tauri/capabilities/*.json .github/workflows/*.yml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.0.0",
    "dompurify": "^3.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
